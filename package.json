{
  "name": "xepelin-growth-case",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel --filter @xepelin/api --filter @xepelin/worker --filter @xepelin/web dev",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @xepelin/infrastructure prisma:generate",
    "db:push": "pnpm --filter @xepelin/infrastructure prisma:push",
    "db:migrate": "pnpm --filter @xepelin/infrastructure prisma:migrate",
    "db:deploy": "pnpm --filter @xepelin/infrastructure prisma:deploy",
    "start:api": "pnpm --filter @xepelin/api start",
    "start:worker": "pnpm --filter @xepelin/worker start",
    "start:web": "pnpm --filter @xepelin/web start",
    "demo:seed": "tsx scripts/seed-demo.ts",
    "demo:seed:llm": "node --env-file=.env --import tsx scripts/seed-llm-scenarios.ts",
    "proof:openai": "node --env-file=.env --import tsx scripts/prove-openai-live.ts",
    "estimate:ai-capacity": "node --import tsx scripts/estimate-ai-capacity.ts"
  },
  "devDependencies": {
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}

// Modelo de datos del pipeline de batches.
// Nota de arquitectura: este schema es un detalle de infraestructura (adaptador de
// persistencia). El dominio (src/domain) NO depende de Prisma; las entidades de dominio
// se mapean desde/hacia estos modelos en los repositorios (infrastructure/outbound).
// Por eso migrar de Postgres a SQL Server (realidad de prod en Forpay) es un cambio de
// adaptador, no de reglas de negocio.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BatchStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum LeadStatus {
  PENDING
  PROCESSING
  READY
  FAILED
  AI_ENRICHING
  AI_READY
  AI_FAILED
}

enum BatchEventType {
  STATE_CHANGE
  WEBHOOK_SENT
}

model Batch {
  id         String      @id @default(uuid())
  name       String
  segment    String
  ownerEmail String      @map("owner_email")
  webhookUrl String?     @map("webhook_url")
  status     BatchStatus @default(PENDING)

  totalLeads    Int @default(0) @map("total_leads")
  readyCount    Int @default(0) @map("ready_count")
  failedCount   Int @default(0) @map("failed_count")
  aiReadyCount  Int @default(0) @map("ai_ready_count")
  aiFailedCount Int @default(0) @map("ai_failed_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  leads  Lead[]
  events BatchEvent[]

  @@map("batches")
}

model Lead {
  id      String @id @default(uuid())
  batchId String @map("batch_id")
  batch   Batch  @relation(fields: [batchId], references: [id], onDelete: Cascade)

  // Orden dentro del batch (0..n-1). Clave determinista para elegir el "ganador"
  // en la deduplicación intra-batch, sin depender de timestamps ni de la concurrencia.
  position Int @default(0)

  // Datos de entrada
  legalId           String  @map("legal_id")
  legalIdNormalized String  @map("legal_id_normalized")
  legalName         String  @map("legal_name")
  website           String?

  status      LeadStatus @default(PENDING)
  errorReason String?    @map("error_reason")

  // Enrichment de contactabilidad (Parte A)
  domain       String?
  normalizedName String? @map("normalized_name")
  websiteAlive Boolean?  @map("website_alive")

  // AI-enrichment (Parte B)
  prospectFitScore Int?    @map("prospect_fit_score")
  fitJustification String? @map("fit_justification")
  iceBreaker       String? @map("ice_breaker")
  painHypothesis   String? @map("pain_hypothesis")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([batchId])
  @@index([batchId, legalIdNormalized])
  @@index([status])
  @@map("leads")
}

model BatchEvent {
  id      String         @id @default(uuid())
  batchId String         @map("batch_id")
  batch   Batch          @relation(fields: [batchId], references: [id], onDelete: Cascade)
  type    BatchEventType

  // Para WEBHOOK_SENT: resultado del intento
  statusCode Int?    @map("status_code")
  attempt    Int?
  success    Boolean?

  // Para STATE_CHANGE: descripción legible
  message String?

  payload Json?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([batchId])
  @@map("batch_events")
}

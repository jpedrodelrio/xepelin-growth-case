DATABASE_URL=postgresql://postgres:postgres@localhost:5432/xepelin_growth
REDIS_URL=redis://localhost:6379
PORT=3001
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001/api
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Demo is deterministic and needs no third-party keys.
AI_PROVIDER=demo
PUBLIC_INFO_PROVIDER=demo
WEBHOOK_PROVIDER=demo

# Live providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini-2025-08-07
OPENAI_FREE_CREDIT_CONFIRMED=false
OPENAI_PROOF_MAX_OUTPUT_TOKENS=1200
# Optional. Live public info falls back to Wikipedia when omitted.
BRAVE_SEARCH_API_KEY=

# Auth.js: demo credentials remain available only when explicitly enabled.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_DEMO_MODE=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
